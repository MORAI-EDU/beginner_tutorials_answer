<launch>
    <node pkg="beginner_tutorials" type="gpsimu_parser_defense.py" name="gpsimu_parser" />
    <node pkg="beginner_tutorials" type="path_pub.py" name="global_path_pub" />
    <node pkg="beginner_tutorials" type="local_path_pub.py" name="local_path_pub" />
    <node pkg="beginner_tutorials" type="stanley.py" name="stanley" output="screen"/>

    <node pkg="beginner_tutorials" type="tf_pub.py" name="tf"  />
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find beginner_tutorials)/rviz/kcity_rviz.rviz" />
</launch>